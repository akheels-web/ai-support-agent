# -----------------------------------------------------------------------------
# OpenAI Realtime Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-YOUR_API_KEY_HERE"
OPENAI_REALTIME_MODEL="gpt-realtime"

# -----------------------------------------------------------------------------
# Ticketing Backend (Frappe Helpdesk)
# -----------------------------------------------------------------------------
FRAPPE_URL="http://127.0.0.1:8000"
FRAPPE_API_KEY="YOUR_FRAPPE_API_KEY"
FRAPPE_API_SECRET="YOUR_FRAPPE_API_SECRET"
FRAPPE_TICKET_DOCTYPE="HD Ticket"
FRAPPE_DEFAULT_TEAM="IT Support"

# -----------------------------------------------------------------------------
# Asterisk Telephony & Escalation Queues
# -----------------------------------------------------------------------------
ASTERISK_AMI_HOST="127.0.0.1"
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER="aiagent"
ASTERISK_AMI_SECRET="CHANGE_ME_AMI_SECRET"
ASTERISK_TRANSFER_CONTEXT="from-internal"

# Multi-Queue Targets
ASTERISK_QUEUE_STANDARD="7001"    # L1 General IT Support Queue
ASTERISK_QUEUE_EXECUTIVE="7002"   # CEO, CFO & Executive Concierge Queue
ASTERISK_QUEUE_EMERGENCY="7003"   # Sev-1 Outage & Incident Response Team

# Asterisk ARI Configuration
ASTERISK_ARI_URL="http://127.0.0.1:8088"
ASTERISK_ARI_USER="asterisk"
ASTERISK_ARI_PASSWORD="asterisk_password"
ASTERISK_ARI_APP="ai-support"

# Asterisk AMI TLS & Capacity Guard
ASTERISK_AMI_TLS="false"              # Set to true if Asterisk AMI uses TLS (port 5039)
ASTERISK_AMI_TLS_VERIFY="true"
ENFORCE_QUEUE_CAPACITY="true"         # Check agent availability before transferring calls
ASTERISK_QUEUE_NAME_STANDARD="it-support"
ASTERISK_QUEUE_NAME_EXECUTIVE="it-vip-exec"
ASTERISK_QUEUE_NAME_EMERGENCY="it-emergency"

# Optional: Media WebSocket SSL (for direct WSS on port 8765 instead of reverse proxy)
ASTERISK_WS_SSL_CERT=""
ASTERISK_WS_SSL_KEY=""

# -----------------------------------------------------------------------------
# Dashboard & Security Configuration
# -----------------------------------------------------------------------------
DASHBOARD_SECRET="change-this-to-a-secure-random-32-character-secret-key"
DASHBOARD_COOKIE_SECURE="false"       # Set to true when serving behind HTTPS
DASHBOARD_HOST="127.0.0.1"            # Bind strictly to loopback behind Nginx reverse proxy
DASHBOARD_PORT=8090
INITIAL_ADMIN_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"

# Rate Limiting & Lockout
CALLS_PER_NUMBER_LIMIT=5
CALLS_PER_NUMBER_WINDOW=600
CALLS_PER_NUMBER_LOCK=900

VERIFY_FAIL_LIMIT=5
VERIFY_FAIL_WINDOW=3600
VERIFY_FAIL_LOCK=3600

# -----------------------------------------------------------------------------
# Enterprise Database Configuration (PostgreSQL 16 on VM 2 with SQLite fallback)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://ai_user:SecurePass123!@192.168.10.12:5432/ai_dashboard"
# Leave DATABASE_URL blank or set to sqlite:///data/dashboard.db for local offline testing
DB_POOL_MIN=2
DB_POOL_MAX=20

# -----------------------------------------------------------------------------
# Active Directory (AD / LDAP) Enterprise Sync Connector
# -----------------------------------------------------------------------------
AD_ENABLED="false"                    # Set to true to enable automated directory sync
AD_SERVER="ldaps://192.168.10.20"     # Domain Controller IP or hostname
AD_PORT=636                           # TCP 636 for LDAPS, 389 for StartTLS
AD_USE_SSL="true"
AD_USE_STARTTLS="false"
AD_VERIFY_CERT="false"                # Set to true in production with valid internal enterprise CA
AD_CA_CERT_PATH=""                    # Path to Enterprise Root CA PEM (optional)
AD_BIND_DN="CN=svc-ai-agent,OU=ServiceAccounts,DC=nationalfinance,DC=local"
AD_PASSWORD="SecureServiceAccountPassword123!"
AD_BASE_DN="DC=nationalfinance,DC=local"
AD_SEARCH_FILTER="(&(objectCategory=person)(objectClass=user))"
AD_PAGE_SIZE=500
AD_SYNC_INTERVAL_MINUTES=30
AD_P0_GROUPS="C-Suite,Executives,CEO,CFO"
AD_P1_GROUPS="Directors,Heads,VIP"

# -----------------------------------------------------------------------------
# Voice Activity Detection (VAD) Tuning (Low latency & background noise rejection)
# -----------------------------------------------------------------------------
VAD_THRESHOLD=0.65
VAD_SILENCE_MS=750
VAD_IDLE_TIMEOUT_MS=30000
